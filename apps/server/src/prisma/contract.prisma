// MTA Market Schema - Prisma 8 (contract.prisma)
// Stage 2: Database & Authentication

// use prisma-next

enum UserRole {
  USER
  ADMIN
  MODERATOR
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

model User {
  id            String       @id @default(uuid())
  email         String       @unique
  emailVerified TimestamptzString?
  username      String?      @unique
  displayName   String?
  avatar        String?
  role          UserRole     @default(USER)
  status        UserStatus   @default(ACTIVE)
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()

  accounts      Account[]
  sessions      Session[]
  resources     Resource[]
  services      Service[]
  purchases     Purchase[]
  servicePurchases ServicePurchase[]
  reviews       Review[]
  sellerBalance SellerBalance?
  transactions  FinancialTransaction[]
  publisherKeys PublisherKey[]
  orders        Order[]
  discountCampaigns DiscountCampaign[]

  @@index([email])
  @@index([username])
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         Int?
  tokenType         String?
  scope             String?
  idToken           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id                 String    @id @default(uuid())
  userId             String
  refreshTokenHash   String    @unique  // SHA-256 hash of refresh token
  tokenFamily        String?   // For rotation: identifies token lineage
  reuseDetected      Boolean   @default(false)  // Flag for token reuse attacks
  expiresAt          TimestamptzString
  createdAt          TimestamptzString @default(now())
  lastRotatedAt      TimestamptzString?  // Track rotation for security audit
  ipAddress          String?
  userAgent          String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([refreshTokenHash])
  @@index([tokenFamily])
}

enum ResourceType {
  SCRIPT
  MAP
  MODEL
  TEXTURE
  SOUND
  GAMEMODE
}

enum ResourceStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  SUSPENDED
}

model Resource {
  id          String         @id @default(uuid())
  sellerId    String
  slug        String         @unique
  title       String
  description String
  type        ResourceType
  status      ResourceStatus @default(DRAFT)
  price       Int
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  seller     User              @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  versions   ResourceVersion[]
  reviews    Review[]

  @@index([sellerId])
  @@index([status])
  @@index([slug])
}

enum ServiceType {
  CUSTOM_DEVELOPMENT  // Custom resource development
  CONFIGURATION       // Server configuration service
  SUPPORT            // Technical support package
  CONSULTATION       // Consulting hours
  OTHER
}

enum ServiceStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  SUSPENDED
}

model Service {
  id           String        @id @default(uuid())
  sellerId     String
  slug         String        @unique
  title        String
  description  String
  type         ServiceType
  status       ServiceStatus @default(DRAFT)
  price        Int           // Fixed price in kopecks
  deliveryDays Int           // Estimated delivery time (days)
  requirements String?       // What buyer needs to provide
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  seller           User                @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  serviceOrderItems ServiceOrderItem[]

  @@index([sellerId])
  @@index([status])
  @@index([slug])
}

model ServiceOrderItem {
  id                String  @id @default(uuid())
  orderId           String
  orderItemId       String? @unique // Phase C bridge: link to the OrderItem aggregate (C-010/C-012)
  serviceId         String
  quantity          Int     @default(1)
  priceSnapshot     Int     // Service price at time of order
  discountId        String?
  discountSnapshot  Int     @default(0)
  finalPrice        Int
  buyerNotes        String? // Special requirements from buyer
  createdAt         TimestamptzString @default(now())

  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  servicePurchase ServicePurchase?
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([serviceId])
}

enum ServicePurchaseStatus {
  PENDING      // Payment not yet completed
  IN_PROGRESS  // Seller working on it
  DELIVERED    // Seller submitted the delivery (C-009/C-011)
  ACCEPTED     // Buyer accepted the delivery; revenue is settled
  CLOSED       // Final terminal state
  CANCELLED    // Cancelled by buyer/seller
  DISPUTED     // Dispute opened (freezes the order)
}

model ServicePurchase {
  id                  String                @id @default(uuid())
  serviceOrderItemId  String                @unique
  buyerId             String
  serviceId           String
  status              ServicePurchaseStatus @default(PENDING)
  priceSnapshot       Int
  discountSnapshot    Int                   @default(0)
  finalPrice          Int
  platformFee         Int
  sellerRevenue       Int
  deliveryDeadline    TimestamptzString?    // Expected completion date
  completedAt         TimestamptzString?
  cancelledAt         TimestamptzString?
  createdAt           TimestamptzString     @default(now())

  serviceOrderItem ServiceOrderItem @relation(fields: [serviceOrderItemId], references: [id], onDelete: Restrict)
  buyer            User             @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  service          Service          @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  messages         ServiceOrderMessage[]
  deliveries       ServiceDelivery[]

  @@index([buyerId])
  @@index([serviceId])
  @@index([status])
}

model ResourceVersion {
  id           String @id @default(uuid())
  resourceId   String
  version      String
  changelog    String?
  fileUrl      String
  fileSize     Int
  fileChecksum String
  publishedAt  TimestamptzString @default(now())

  resource  Resource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  licenses  License[]
  purchases Purchase[]
  signature ArtifactSignature?
  sandboxRuns SandboxRun[]

  @@unique([resourceId, version])
  @@index([resourceId])
}

enum PurchaseStatus {
  PENDING    // Awaiting payment
  COMPLETED  // Payment successful, entitlement granted
  REFUNDED   // Payment refunded
  DISPUTED   // Payment/order in dispute
  FAILED     // Payment failed
}


model Purchase {
  id                 String         @id @default(uuid())
  orderItemId        String?        @unique // Phase C bridge: link to OrderItem when commerce rewrite lands
  buyerId            String
  resourceId         String
  versionId          String
  status             PurchaseStatus @default(PENDING)
  priceSnapshot      Int            // Copied from OrderItem
  discountSnapshot   Int            @default(0) // Copied from OrderItem
  finalPrice         Int            // Copied from OrderItem
  platformFee        Int            // Platform's share
  sellerRevenue      Int            // Seller's share
  createdAt          TimestamptzString @default(now())
  completedAt        TimestamptzString?
  refundedAt         TimestamptzString?

  buyer     User            @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  version   ResourceVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  orderItem OrderItem?      @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  license   License?

  @@index([buyerId])
  @@index([resourceId])
  @@index([orderItemId])
}

enum LicenseStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model License {
  id           String        @id @default(uuid())
  purchaseId   String        @unique
  versionId    String
  serverSerial String?
  status       LicenseStatus @default(ACTIVE)
  activatedAt  TimestamptzString?
  revokedAt    TimestamptzString?
  expiresAt    TimestamptzString?
  createdAt    TimestamptzString @default(now())

  purchase      Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  version       ResourceVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  installations Installation[]

  @@index([serverSerial])
  @@index([status])
}

enum InstallationStatus {
  PENDING_VERIFICATION  // Awaiting challenge response
  ACTIVE
  REVOKED
}

model Installation {
  id            String             @id @default(uuid())
  licenseId     String
  publicKey     String             @unique // Ed25519 public key (client-side generated)
  challenge     String?            // Pending verification challenge
  serverSerial  String?            // MTA server serial (optional metadata)
  serverName    String?
  mtaVersion    String?            // MTA:SA version
  moduleVersion String?            // mta-market-module version
  status        InstallationStatus @default(PENDING_VERIFICATION)
  verifiedAt    TimestamptzString? // When challenge was verified
  installedAt   TimestamptzString @default(now())
  lastHeartbeat TimestamptzString?
  revokedAt     TimestamptzString?
  revokedBy     String?
  revocationReason String?

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  leases  Lease[]

  @@index([licenseId])
  @@index([publicKey])
  @@index([serverSerial])
  @@index([status])
}

enum PaymentProvider {
  YUKASSA
  STRIPE
  TEST
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payment {
  id                String          @id @default(uuid())
  purchaseId        String?         @unique // Resource payments (Phase C bridge); null for service payments
  orderItemId       String?         @unique // C-012: service/other payments attach to their OrderItem
  provider          PaymentProvider
  providerPaymentId String          @unique
  status            PaymentStatus   @default(PENDING)
  amount            Int             // Total order amount
  currency          String          @default("RUB")
  metadata          Json?
  createdAt         TimestamptzString @default(now())
  succeededAt       TimestamptzString?
  failedAt          TimestamptzString?

  @@index([providerPaymentId])
  @@index([status])
}

enum ProviderEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

// Immutable/idempotent record of every payment-provider webhook.
model PaymentProviderEvent {
  id              String              @id @default(uuid())
  provider        PaymentProvider
  providerEventId String
  objectId        String
  eventType       String
  objectType      String?
  payloadHash     String
  payload         Json?
  status          ProviderEventStatus @default(RECEIVED)
  attempts        Int                 @default(0)
  lastError       String?
  receivedAt      TimestamptzString   @default(now())
  processedAt     TimestamptzString?

  @@unique([provider, providerEventId, eventType])
  @@index([objectId])
  @@index([status])
}

enum TransactionType {
  PAYMENT_RECEIVED
  PLATFORM_FEE
  SELLER_REVENUE
  SELLER_PAYOUT
  REFUND_TO_BUYER
  REFUND_FROM_SELLER
  ADJUSTMENT
}

model FinancialTransaction {
  id                String          @id @default(uuid())
  userId            String
  type              TransactionType
  amount            Int
  balanceAfter      Int
  relatedPurchaseId String?
  relatedPayoutId   String?
  metadata          Json?
  createdAt         TimestamptzString @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model SellerBalance {
  userId          String @id
  availableAmount Int @default(0)
  inEscrowAmount  Int @default(0)
  totalEarned     Int @default(0)
  updatedAt       temporal.updatedAtString()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Review {
  id         String @id @default(uuid())
  resourceId String
  buyerId    String
  rating     Int
  comment    String?
  createdAt  TimestamptzString @default(now())
  updatedAt  temporal.updatedAtString()

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  buyer    User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@unique([resourceId, buyerId])
  @@index([resourceId])
  @@index([buyerId])
}

// ============================================
// TASK-019: Artifact Signing Models
// ============================================

enum KeyStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

// Publisher cryptographic keys for signing artifacts
model PublisherKey {
  id          String    @id @default(uuid())
  sellerId    String
  keyType     String    @default("ED25519") // ED25519, RSA
  publicKey   String    // Base64 encoded public key
  algorithm   String    @default("EdDSA")   // EdDSA, RS256
  status      KeyStatus @default(ACTIVE)
  createdAt   TimestamptzString @default(now())
  revokedAt   TimestamptzString?
  revokedBy   String?
  revocationReason String?

  seller    User                @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  signatures ArtifactSignature[]

  @@index([sellerId])
  @@index([status])
  @@index([publicKey])
}

// Cryptographic signatures for resource artifacts
model ArtifactSignature {
  id           String @id @default(uuid())
  versionId    String @unique
  keyId        String
  signature    String  // Base64 encoded signature
  algorithm    String  // EdDSA, RS256
  manifestHash String  // SHA-256 of canonical manifest JSON
  artifactHash String  // SHA-256 of artifact file
  manifest     Json    // Complete artifact manifest
  signedAt     TimestamptzString @default(now())
  verifiedAt   TimestamptzString? // Last verification timestamp

  version ResourceVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  key     PublisherKey    @relation(fields: [keyId], references: [id], onDelete: Restrict)

  @@index([versionId])
  @@index([keyId])
  @@index([artifactHash])
}

// ============================================
// TASK-020: DRM Protocol v2 Models
// ============================================

// Server cryptographic keys for signing DRM leases
model ServerSigningKey {
  id         String    @id @default(uuid())
  keyType    String    @default("ED25519") // ED25519, RSA
  publicKey  String    // Base64 encoded public key
  algorithm  String    @default("EdDSA")   // EdDSA, RS256
  status     KeyStatus @default(ACTIVE)
  createdAt  TimestamptzString @default(now())
  revokedAt  TimestamptzString?
  revokedBy  String?
  revocationReason String?

  leases Lease[]

  @@index([status])
}

// DRM lease issued to installation for resource access
model Lease {
  id               String @id @default(uuid())
  installationId   String
  licenseId        String
  resourceId       String
  resourceVersionId String
  artifactHash     String          // SHA-256 of artifact
  nonce            String @unique  // Replay protection
  protocolVersion  Int    @default(2)
  serverKeyId      String          // ServerSigningKey used
  signature        String          // Base64 encoded signature
  capabilities     Json            // ["run", "update", etc]
  issuedAt         TimestamptzString @default(now())
  expiresAt        TimestamptzString
  lastVerifiedAt   TimestamptzString?

  installation Installation     @relation(fields: [installationId], references: [id], onDelete: Cascade)
  serverKey    ServerSigningKey @relation(fields: [serverKeyId], references: [id], onDelete: Restrict)

  @@index([installationId])
  @@index([licenseId])
  @@index([nonce])
  @@index([expiresAt])
  @@index([issuedAt])
}

// ============================================
// TASK-022: Upload Sandbox Models
// ============================================

enum SandboxStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  TIMEOUT
  SECURITY_VIOLATION
}

// Sandbox execution run for artifact validation
model SandboxRun {
  id                 String        @id @default(uuid())
  versionId          String
  status             SandboxStatus @default(PENDING)
  startedAt          TimestamptzString @default(now())
  completedAt        TimestamptzString?
  timeoutSeconds     Int           @default(60)
  cpuLimit           Int           @default(1)
  memoryLimitMb      Int           @default(512)
  exitCode           Int?
  stdout             String?       // Execution output
  stderr             String?       // Error output
  staticValidation   Json?         // Static validation results
  compatibilityReport Json?        // Compatibility report
  securityReport     Json?         // Security issues found
  containerId        String?       // Docker container ID
  
  version ResourceVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  
  @@index([versionId])
  @@index([status])
  @@index([startedAt])
}

// ============================================
// TASK-018: Reconciliation Models
// ============================================

enum ReconciliationStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum ReconciliationReportType {
  PAYMENT
  REFUND
  PAYOUT
}

enum MismatchType {
  MISSING_INTERNAL     // Transaction exists in provider but not internal
  MISSING_PROVIDER     // Transaction exists internally but not in provider
  AMOUNT_MISMATCH      // Same transaction, different amounts
  STATUS_MISMATCH      // Same transaction, different status
}

// Reconciliation report for comparing internal vs provider records
model ReconciliationReport {
  id                String                 @id @default(uuid())
  provider          String                 // YUKASSA, STRIPE, etc.
  reportType        ReconciliationReportType
  periodStart       TimestamptzString
  periodEnd         TimestamptzString
  internalCount     Int
  internalTotal     Int                    // Total amount in internal records
  providerCount     Int
  providerTotal     Int                    // Total amount in provider records
  mismatchCount     Int
  status            ReconciliationStatus   @default(PENDING)
  createdAt         TimestamptzString      @default(now())
  completedAt       TimestamptzString?
  errorMessage      String?

  mismatches ReconciliationMismatch[]

  @@index([provider])
  @@index([reportType])
  @@index([status])
  @@index([createdAt])
}

// Individual mismatch found during reconciliation
model ReconciliationMismatch {
  id               String        @id @default(uuid())
  reportId         String
  type             MismatchType
  internalId       String?       // Internal transaction ID
  providerId       String?       // Provider transaction ID
  expectedAmount   Int?          // Amount we expected
  actualAmount     Int?          // Amount provider reports
  description      String
  resolved         Boolean       @default(false)
  resolvedAt       TimestamptzString?
  resolvedBy       String?
  resolution       String?       // How it was resolved
  createdAt        TimestamptzString @default(now())

  report ReconciliationReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([type])
  @@index([resolved])
}

// ---------------------------------------------------------------------------
// PLAN Block 4 / C-012: Order is the checkout aggregate.
// Order     = commercial checkout intent (one or more immutable priced lines)
// OrderItem = immutable priced line (snapshot of base price, discount, fees)
// Purchase  = completed RESOURCE purchase (existing model, stays compatible)
// Migration path: resources keep Purchase as the completion record (Payment
// webhooks are bound to purchaseId); new checkouts create Order+OrderItem and
// link the Purchase via Purchase.orderItemId. Services use ServiceOrderItem
// linked via ServiceOrderItem.orderItemId.
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING    // Checkout created, awaiting payment/free completion
  COMPLETED  // All items fulfilled
  CANCELLED  // Cancelled before completion
}

enum OrderItemType {
  RESOURCE
  SERVICE
}

enum DiscountType {
  PERCENT // value = whole percent (1..100)
  FIXED   // value = kopecks
}

enum DiscountScope {
  ALL
  RESOURCE
  SERVICE
}

// C-004: seller-owned discount campaign.
model DiscountCampaign {
  id             String        @id @default(uuid())
  sellerId       String
  name           String
  code           String? // optional promo code; unique per seller when set
  type           DiscountType
  value          Int // PERCENT: 1..100; FIXED: kopecks
  currency       String        @default("RUB")
  scope          DiscountScope @default(ALL)
  scopeId        String? // resourceId or serviceId when scope != ALL
  startsAt       TimestamptzString?
  endsAt         TimestamptzString?
  isActive       Boolean       @default(true)
  usageLimit     Int? // max total uses; null = unlimited
  perUserLimit   Int? // MVP: null (unlimited) or 1
  minOrderAmount Int? // kopecks; item base price must be >= this
  exclusive      Boolean       @default(true) // MVP: a campaign is exclusive (one per item)
  usedCount      Int           @default(0) // atomic CAS counter for usageLimit (C-007)
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()

  seller User             @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  usages DiscountUsage[]
  items  OrderItem[]

  @@unique([sellerId, code])
  @@index([sellerId])
  @@index([isActive])
}

// C-007: usage records are created atomically at order completion —
// failed orders never increment usage (INV-014).
model DiscountUsage {
  id          String @id @default(uuid())
  campaignId  String
  userId      String
  orderId     String
  orderItemId String
  amount      Int // kopecks actually discounted for this line
  createdAt   TimestamptzString @default(now())

  campaign DiscountCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, orderItemId]) // idempotent completion
  @@index([campaignId, userId])
  @@index([orderId])
}

// C-012: checkout aggregate.
model Order {
  id            String      @id @default(uuid())
  buyerId       String
  status        OrderStatus @default(PENDING)
  currency      String      @default("RUB")
  subtotal      Int         @default(0) // sum of item base prices (kopecks)
  discountTotal Int         @default(0)
  finalTotal    Int         @default(0)
  completedAt   TimestamptzString?
  cancelledAt   TimestamptzString?
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()

  buyer User        @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  items OrderItem[]

  @@index([buyerId])
  @@index([status])
}

// C-006: immutable price/discount snapshot on the priced line.
model OrderItem {
  id                 String        @id @default(uuid())
  orderId            String
  itemType           OrderItemType
  resourceId         String? // audit snapshot; not an FK (historical orders survive product edits/removal)
  serviceId          String?
  sellerId           String
  titleSnapshot      String
  currency           String        @default("RUB")
  basePrice          Int // kopecks at checkout time
  discountCampaignId String?
  discountCode       String?
  discountAmount     Int           @default(0)
  finalPrice         Int
  platformFee        Int
  sellerNet          Int
  createdAt          TimestamptzString @default(now())

  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  discountCampaign DiscountCampaign? @relation(fields: [discountCampaignId], references: [id], onDelete: SetNull)
  purchase         Purchase?
  serviceOrderItem ServiceOrderItem?

  @@index([orderId])
  @@index([discountCampaignId])
  @@index([sellerId])
}

// C-011: buyer/seller communication inside a service order.
model ServiceOrderMessage {
  id                 String @id @default(uuid())
  servicePurchaseId  String
  senderId           String
  senderRole         String // BUYER | SELLER | ADMIN
  body               String
  createdAt          TimestamptzString @default(now())

  servicePurchase ServicePurchase @relation(fields: [servicePurchaseId], references: [id], onDelete: Cascade)

  @@index([servicePurchaseId])
}

// C-011: seller's delivery submission for a service order.
model ServiceDelivery {
  id                String @id @default(uuid())
  servicePurchaseId String
  sellerId          String
  notes             String
  deliverableRef    String? // reference to uploaded deliverable (storage key / URL)
  createdAt         TimestamptzString @default(now())

  servicePurchase ServicePurchase    @relation(fields: [servicePurchaseId], references: [id], onDelete: Cascade)
  revisions       ServiceRevision[]

  @@index([servicePurchaseId])
}

// C-011: buyer's revision request against a delivery.
model ServiceRevision {
  id                String @id @default(uuid())
  servicePurchaseId String
  deliveryId        String
  requestedBy       String
  reason            String
  status            String @default("OPEN") // OPEN | ADDRESSED
  createdAt         TimestamptzString @default(now())
  resolvedAt        TimestamptzString?

  delivery ServiceDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([servicePurchaseId])
  @@index([deliveryId])
}
