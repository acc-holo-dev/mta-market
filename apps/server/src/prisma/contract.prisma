// MTA Market Schema - Prisma 8 (contract.prisma)
// Stage 2: Database & Authentication

// use prisma-next

enum UserRole {
  USER
  ADMIN
  MODERATOR
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  emailVerified TimestamptzString?
  username      String?      @unique
  displayName   String?
  avatar        String?
  role          UserRole     @default(USER)
  status        UserStatus   @default(ACTIVE)
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()

  accounts      Account[]
  sessions      Session[]
  resources     Resource[]
  services      Service[]
  orders        Order[]
  purchases     Purchase[]
  servicePurchases ServicePurchase[]
  reviews       Review[]
  discounts     Discount[]    // Discounts created by this user (admin/seller)
  sellerBalance SellerBalance?
  transactions  FinancialTransaction[]

  @@index([email])
  @@index([username])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         Int?
  tokenType         String?
  scope             String?
  idToken           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id                 String    @id @default(cuid())
  userId             String
  refreshTokenHash   String    @unique  // SHA-256 hash of refresh token
  tokenFamily        String?   // For rotation: identifies token lineage
  reuseDetected      Boolean   @default(false)  // Flag for token reuse attacks
  expiresAt          TimestamptzString
  createdAt          TimestamptzString @default(now())
  lastRotatedAt      TimestamptzString?  // Track rotation for security audit
  ipAddress          String?
  userAgent          String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([refreshTokenHash])
  @@index([tokenFamily])
}

enum ResourceType {
  SCRIPT
  MAP
  MODEL
  TEXTURE
  SOUND
  GAMEMODE
}

enum ResourceStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  SUSPENDED
}

model Resource {
  id          String         @id @default(cuid())
  sellerId    String
  slug        String         @unique
  title       String
  description String
  type        ResourceType
  status      ResourceStatus @default(DRAFT)
  price       Int
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  seller     User              @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  versions   ResourceVersion[]
  reviews    Review[]
  discounts  Discount[]        // Discounts for this specific resource
  orderItems OrderItem[]       // Order items referencing this resource

  @@index([sellerId])
  @@index([status])
  @@index([slug])
}

enum ServiceType {
  CUSTOM_DEVELOPMENT  // Custom resource development
  CONFIGURATION       // Server configuration service
  SUPPORT            // Technical support package
  CONSULTATION       // Consulting hours
  OTHER
}

enum ServiceStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  SUSPENDED
}

model Service {
  id           String        @id @default(cuid())
  sellerId     String
  slug         String        @unique
  title        String
  description  String
  type         ServiceType
  status       ServiceStatus @default(DRAFT)
  price        Int           // Fixed price in kopecks
  deliveryDays Int           // Estimated delivery time (days)
  requirements String?       // What buyer needs to provide
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  seller           User                @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  reviews          Review[]
  discounts        Discount[]
  serviceOrderItems ServiceOrderItem[]

  @@index([sellerId])
  @@index([status])
  @@index([slug])
}

model ServiceOrderItem {
  id                String  @id @default(cuid())
  orderId           String
  serviceId         String
  quantity          Int     @default(1)
  priceSnapshot     Int     // Service price at time of order
  discountId        String?
  discountSnapshot  Int     @default(0)
  finalPrice        Int
  buyerNotes        String? // Special requirements from buyer
  createdAt         TimestamptzString @default(now())

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  servicePurchase ServicePurchase?

  @@index([orderId])
  @@index([serviceId])
}

enum ServicePurchaseStatus {
  PENDING      // Payment not yet completed
  IN_PROGRESS  // Seller working on it
  COMPLETED    // Service delivered
  CANCELLED    // Cancelled by buyer/seller
  DISPUTED     // Dispute opened
}

model ServicePurchase {
  id                  String                @id @default(cuid())
  serviceOrderItemId  String                @unique
  buyerId             String
  serviceId           String
  status              ServicePurchaseStatus @default(PENDING)
  priceSnapshot       Int
  discountSnapshot    Int                   @default(0)
  finalPrice          Int
  platformFee         Int
  sellerRevenue       Int
  deliveryDeadline    TimestamptzString?    // Expected completion date
  completedAt         TimestamptzString?
  cancelledAt         TimestamptzString?
  createdAt           TimestamptzString     @default(now())

  serviceOrderItem ServiceOrderItem @relation(fields: [serviceOrderItemId], references: [id], onDelete: Restrict)
  buyer            User             @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  service          Service          @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([buyerId])
  @@index([serviceId])
  @@index([status])
}

model ResourceVersion {
  id           String @id @default(cuid())
  resourceId   String
  version      String
  changelog    String?
  fileUrl      String
  fileSize     Int
  fileChecksum String
  publishedAt  TimestamptzString @default(now())

  resource  Resource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  licenses  License[]
  purchases Purchase[]

  @@unique([resourceId, version])
  @@index([resourceId])
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  REFUNDED
  DISPUTED
}

enum DiscountType {
  PERCENTAGE // Percentage off (e.g., 20% off)
  FIXED      // Fixed amount off (e.g., 100 RUB off)
}

model Discount {
  id          String       @id @default(cuid())
  name        String       // Display name (e.g., "Summer Sale 2026")
  code        String?      @unique // Optional promo code (e.g., "SUMMER20")
  type        DiscountType
  value       Int          // Percentage (20 = 20%) or fixed amount in kopecks
  resourceId  String?      // Specific resource (null = any)
  serviceId   String?      // Specific service (null = any)
  minPurchase Int?         // Minimum purchase amount (kopecks, null = no minimum)
  maxDiscount Int?         // Maximum discount amount (kopecks, null = no cap)
  usageLimit  Int?         // Total usage limit (null = unlimited)
  usageCount  Int          @default(0) // Current usage count
  startsAt    TimestamptzString
  expiresAt   TimestamptzString?
  createdAt   TimestamptzString @default(now())
  createdBy   String       // Admin/seller who created it

  resource Resource? @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  service  Service?  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  creator  User      @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([code])
  @@index([resourceId])
  @@index([serviceId])
  @@index([startsAt])
  @@index([expiresAt])
}

enum OrderStatus {
  CART          // User is building cart
  PENDING       // Order submitted, awaiting payment
  PROCESSING    // Payment received, processing fulfillment
  COMPLETED     // All items fulfilled
  CANCELLED     // User cancelled
  FAILED        // Payment failed
}

model Order {
  id              String      @id @default(cuid())
  buyerId         String
  status          OrderStatus @default(CART)
  totalAmount     Int         // Sum of all items after discounts
  platformFee     Int         // Platform fee on total
  createdAt       TimestamptzString @default(now())
  submittedAt     TimestamptzString? // When user clicked "checkout"
  completedAt     TimestamptzString?
  cancelledAt     TimestamptzString?

  buyer       User        @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  items       OrderItem[]
  serviceItems ServiceOrderItem[]
  payment     Payment?    // One payment for entire order

  @@index([buyerId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id                String  @id @default(cuid())
  orderId           String
  resourceId        String
  versionId         String  // Snapshot: which version at time of order
  quantity          Int     @default(1) // For future: multi-license purchases
  priceSnapshot     Int     // Resource price at time of adding to cart
  discountId        String?
  discountSnapshot  Int     @default(0)
  finalPrice        Int     // priceSnapshot - discountSnapshot
  createdAt         TimestamptzString @default(now())

  order    Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  resource Resource        @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  version  ResourceVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  purchase Purchase?       // Created after payment completes

  @@index([orderId])
  @@index([resourceId])
}

enum PurchaseStatus {
  PENDING    // Awaiting payment
  COMPLETED  // Payment successful, entitlement granted
  REFUNDED   // Payment refunded
  FAILED     // Payment failed
}

model Purchase {
  id                 String         @id @default(cuid())
  orderItemId        String         @unique // One purchase per order item
  buyerId            String
  resourceId         String
  versionId          String
  status             PurchaseStatus @default(PENDING)
  priceSnapshot      Int            // Copied from OrderItem
  discountSnapshot   Int            @default(0) // Copied from OrderItem
  finalPrice         Int            // Copied from OrderItem
  platformFee        Int            // Platform's share
  sellerRevenue      Int            // Seller's share
  createdAt          TimestamptzString @default(now())
  completedAt        TimestamptzString?
  refundedAt         TimestamptzString?

  orderItem OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  buyer     User            @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  version   ResourceVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  license   License?

  @@index([buyerId])
  @@index([resourceId])
  @@index([orderItemId])
}

enum LicenseStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model License {
  id           String        @id @default(cuid())
  purchaseId   String        @unique
  versionId    String
  serverSerial String?
  status       LicenseStatus @default(ACTIVE)
  activatedAt  TimestamptzString?
  revokedAt    TimestamptzString?
  expiresAt    TimestamptzString?
  createdAt    TimestamptzString @default(now())

  purchase      Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  version       ResourceVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  installations Installation[]

  @@index([serverSerial])
  @@index([status])
}

enum InstallationStatus {
  ACTIVE
  REVOKED
}

model Installation {
  id            String             @id @default(cuid())
  licenseId     String
  publicKey     String
  privateKey    String
  serverSerial  String
  serverName    String?
  status        InstallationStatus @default(ACTIVE)
  installedAt   TimestamptzString @default(now())
  lastHeartbeat TimestamptzString?

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId])
  @@index([serverSerial])
}

enum PaymentProvider {
  YUKASSA
  STRIPE
  TEST
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payment {
  id                String          @id @default(cuid())
  orderId           String          @unique // One payment per order
  provider          PaymentProvider
  providerPaymentId String          @unique
  status            PaymentStatus   @default(PENDING)
  amount            Int             // Total order amount
  currency          String          @default("RUB")
  metadata          Json?
  createdAt         TimestamptzString @default(now())
  succeededAt       TimestamptzString?
  failedAt          TimestamptzString?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([providerPaymentId])
  @@index([status])
}

enum ProviderEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

// Immutable/idempotent record of every payment-provider webhook.
model PaymentProviderEvent {
  id              String              @id @default(cuid())
  provider        PaymentProvider
  providerEventId String
  objectId        String
  eventType       String
  objectType      String?
  payloadHash     String
  payload         Json?
  status          ProviderEventStatus @default(RECEIVED)
  attempts        Int                 @default(0)
  lastError       String?
  receivedAt      TimestamptzString   @default(now())
  processedAt     TimestamptzString?

  @@unique([provider, providerEventId, eventType])
  @@index([objectId])
  @@index([status])
}

enum TransactionType {
  PAYMENT_RECEIVED
  PLATFORM_FEE
  SELLER_REVENUE
  SELLER_PAYOUT
  REFUND_TO_BUYER
  REFUND_FROM_SELLER
  ADJUSTMENT
}

model FinancialTransaction {
  id                String          @id @default(cuid())
  userId            String
  type              TransactionType
  amount            Int
  balanceAfter      Int
  relatedPurchaseId Int?
  relatedPayoutId   Int?
  metadata          Json?
  createdAt         TimestamptzString @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model SellerBalance {
  userId          String @id
  availableAmount Int @default(0)
  inEscrowAmount  Int @default(0)
  totalEarned     Int @default(0)
  updatedAt       temporal.updatedAtString()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Review {
  id         String @id @default(cuid())
  resourceId Int
  buyerId    String
  rating     Int
  comment    String?
  createdAt  TimestamptzString @default(now())
  updatedAt  temporal.updatedAtString()

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  buyer    User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@unique([resourceId, buyerId])
  @@index([resourceId])
  @@index([buyerId])
}
