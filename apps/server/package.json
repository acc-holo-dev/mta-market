{
  "name": "@mta-market/server",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "postinstall": "prisma skills sync || exit 0",
    "contract:emit": "prisma contract emit",
    "artifact:keygen": "tsx src/cli/artifact.ts keygen",
    "artifact:sign": "tsx src/cli/artifact.ts sign",
    "artifact:verify": "tsx src/cli/artifact.ts verify",
    "artifact:keys": "tsx src/cli/artifact.ts keys",
    "artifact:revoke": "tsx src/cli/artifact.ts revoke",
    "drm:keygen": "tsx src/cli/drm.ts keygen",
    "drm:test-installation": "tsx src/cli/drm.ts test-installation",
    "drm:generate-nonce": "tsx src/cli/drm.ts generate-nonce",
    "drm:info": "tsx src/cli/drm.ts info",
    "reconciliation:run": "tsx -e \"require('./src/jobs/reconciliation').runDailyReconciliation()\"",
    "reconciliation:summary": "tsx -e \"require('./src/lib/reconciliation/service').getReconciliationSummary().then(console.log)\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@prisma/client": "^7.10.0",
    "@prisma/orm-postgres": "8.0.0-rc.8",
    "@types/multer": "^2.2.0",
    "@types/nodemailer": "^8.0.1",
    "bcryptjs": "^3.0.3",
    "commander": "^12.1.0",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@mta-market/eslint-config": "workspace:*",
    "@mta-market/tsconfig": "workspace:*",
    "@prisma/cli-engine": "0.2.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.2",
    "prisma": "8.0.0-rc.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
