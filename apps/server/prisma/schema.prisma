// Prisma Schema для MTA Market
// Stage 2: База данных и аутентификация

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USERS & AUTH
// ============================================================================

enum UserRole {
  USER
  ADMIN
  MODERATOR
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  emailVerified DateTime?
  username      String?      @unique
  displayName   String?
  avatar        String?
  role          UserRole     @default(USER)
  status        UserStatus   @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Relations
  accounts      Account[]
  sessions      Session[]
  resources     Resource[]
  purchases     Purchase[]
  reviews       Review[]
  sellerBalance SellerBalance?
  transactions  FinancialTransaction[]

  @@index([email])
  @@index([username])
  @@map("users")
}

// OAuth accounts (Discord, Google, GitHub)
model Account {
  id                String  @id @default(cuid())
  userId            String
  provider          String  // discord, google, github
  providerAccountId String
  accessToken       String? @db.Text
  refreshToken      String? @db.Text
  expiresAt         Int?
  tokenType         String?
  scope             String?
  idToken           String? @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

// JWT sessions (refresh tokens)
model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique @db.Text
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  ipAddress    String?
  userAgent    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ============================================================================
// RESOURCES (PRODUCTS)
// ============================================================================

enum ResourceType {
  SCRIPT
  MAP
  MODEL
  TEXTURE
  SOUND
  GAMEMODE
}

enum ResourceStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  SUSPENDED
}

model Resource {
  id          String         @id @default(cuid())
  sellerId    String
  slug        String         @unique
  title       String
  description String         @db.Text
  type        ResourceType
  status      ResourceStatus @default(DRAFT)
  price       Int            // в копейках (RUB * 100)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  seller   User              @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  versions ResourceVersion[]
  reviews  Review[]

  @@index([sellerId])
  @@index([status])
  @@index([slug])
  @@map("resources")
}

model ResourceVersion {
  id           String   @id @default(cuid())
  resourceId   String
  version      String   // semver: "1.2.3"
  changelog    String?  @db.Text
  fileUrl      String   // S3/CDN URL (encrypted .zip)
  fileSize     Int      // bytes
  fileChecksum String   // SHA-256
  publishedAt  DateTime @default(now())

  resource    Resource     @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  licenses    License[]
  purchases   Purchase[]

  @@unique([resourceId, version])
  @@index([resourceId])
  @@map("resource_versions")
}

// ============================================================================
// PURCHASES & LICENSES (DRM)
// ============================================================================

enum PurchaseStatus {
  PENDING
  COMPLETED
  REFUNDED
  DISPUTED
}

// Snapshot покупки (immutable после создания)
model Purchase {
  id              String         @id @default(cuid())
  buyerId         String
  resourceId      String
  versionId       String
  paymentId       String         @unique
  status          PurchaseStatus @default(PENDING)
  priceSnapshot   Int            // цена на момент покупки (копейки)
  platformFee     Int            // комиссия площадки (копейки)
  sellerRevenue   Int            // выплата продавцу (копейки)
  createdAt       DateTime       @default(now())
  completedAt     DateTime?
  refundedAt      DateTime?

  buyer   User            @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  version ResourceVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  license License?
  payment Payment?

  @@index([buyerId])
  @@index([resourceId])
  @@index([paymentId])
  @@map("purchases")
}

enum LicenseStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

// DRM-лицензия (привязана к серверу MTA)
model License {
  id           String        @id @default(cuid())
  purchaseId   String        @unique
  versionId    String
  serverSerial String?       // MTA server serial (после первой активации)
  status       LicenseStatus @default(ACTIVE)
  activatedAt  DateTime?
  revokedAt    DateTime?
  expiresAt    DateTime?     // NULL = бессрочная
  createdAt    DateTime      @default(now())

  purchase      Purchase        @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  version       ResourceVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  installations Installation[]

  @@index([serverSerial])
  @@index([status])
  @@map("licenses")
}

enum InstallationStatus {
  ACTIVE
  REVOKED
}

// Установка лицензии (keypair для сервера)
model Installation {
  id            String             @id @default(cuid())
  licenseId     String
  publicKey     String             @db.Text // RSA public key
  privateKey    String             @db.Text // RSA private key (encrypted)
  serverSerial  String
  serverName    String?
  status        InstallationStatus @default(ACTIVE)
  installedAt   DateTime           @default(now())
  lastHeartbeat DateTime?

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId])
  @@index([serverSerial])
  @@map("installations")
}

// ============================================================================
// PAYMENTS & FINANCIAL LEDGER
// ============================================================================

enum PaymentProvider {
  YUKASSA
  STRIPE
  TEST
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payment {
  id                String          @id @default(cuid())
  purchaseId        String          @unique
  provider          PaymentProvider
  providerPaymentId String          @unique // external ID от провайдера
  status            PaymentStatus   @default(PENDING)
  amount            Int             // копейки
  currency          String          @default("RUB")
  metadata          Json?           // дополнительные данные от провайдера
  createdAt         DateTime        @default(now())
  succeededAt       DateTime?
  failedAt          DateTime?

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([providerPaymentId])
  @@index([status])
  @@map("payments")
}

enum TransactionType {
  PAYMENT_RECEIVED
  PLATFORM_FEE
  SELLER_REVENUE
  SELLER_PAYOUT
  REFUND_TO_BUYER
  REFUND_FROM_SELLER
  ADJUSTMENT
}

// Immutable append-only ledger (двойная запись)
model FinancialTransaction {
  id          String          @id @default(cuid())
  userId      String
  type        TransactionType
  amount      Int             // копейки (+ или -)
  balanceAfter Int            // баланс после транзакции
  relatedPurchaseId String?
  relatedPayoutId   String?
  metadata    Json?
  createdAt   DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("financial_transactions")
}

// Баланс продавца (derived от transactions)
model SellerBalance {
  userId          String   @id
  availableAmount Int      @default(0) // копейки
  inEscrowAmount  Int      @default(0) // копейки
  totalEarned     Int      @default(0) // копейки
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("seller_balances")
}

// ============================================================================
// REVIEWS
// ============================================================================

model Review {
  id         String   @id @default(cuid())
  resourceId String
  buyerId    String
  rating     Int      // 1-5
  comment    String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  buyer    User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@unique([resourceId, buyerId]) // один отзыв от покупателя на ресурс
  @@index([resourceId])
  @@index([buyerId])
  @@map("reviews")
}
