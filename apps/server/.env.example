# Database
DATABASE_URL="postgresql://mtamarket:dev_password@localhost:5432/mtamarket"

# JWT
# Generate with: openssl rand -base64 64
JWT_SECRET=""
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# OAuth2 Discord
DISCORD_CLIENT_ID="your-discord-client-id"
DISCORD_CLIENT_SECRET="your-discord-client-secret"
DISCORD_REDIRECT_URI="http://localhost:3001/auth/discord/callback"

# Redis
REDIS_URL="redis://localhost:6379"

# Server
PORT=3001
BASE_URL="http://localhost:3001"
FRONTEND_URL="http://localhost:3000"

# File Upload
UPLOAD_DIR="./uploads"

# S3 / Cloudflare R2 (optional)
S3_ENABLED="false"
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_ENDPOINT="" # For Cloudflare R2: https://account-id.r2.cloudflarestorage.com

# YooKassa (optional)
YOOKASSA_ENABLED="false"
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""
YOOKASSA_NOTIFICATION_PASSWORD=""
# Signed download URL TTL in seconds (default 300, max 900)
S3_SIGNED_URL_TTL="300"

# Email (optional)
EMAIL_ENABLED="false"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@mtamarket.com"
