# Dependencies
node_modules
.pnpm-store

# Build outputs
dist
.next
out

# Environment
# PLAN-004 G-001 (audit GAP-07): patterns must match at ANY depth — the old
# root-anchored `.env` left apps/server/.env (real signing keys in dev) and
# apps/web/.env.local in the build context, where COPY . . baked them into
# builder layers (and GHA cache).
**/.env
**/.env.*
**/*.pem
**/*.key
.keys

# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*

