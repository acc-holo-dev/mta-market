{
  "name": "mta-market",
  "version": "0.1.0",
  "private": true,
  "description": "MTA:SA Marketplace — DRM-защищённая площадка продаж серверных ресурсов",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "turbo run type-check",
    "db:emit": "pnpm --filter @mta-market/server contract:emit",
    "test:server": "pnpm --filter @mta-market/server test",
    "test:e2e:admin": "pnpm --filter @mta-market/server exec tsx scripts/dev-admin.ts --email e2e-admin@mtamarket.local --username e2e-admin --password e2e-admin-password-123",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
