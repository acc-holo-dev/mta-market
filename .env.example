# Docker Compose Environment Variables
# Copy this file to `.env` and fill in your values

# JWT
JWT_SECRET=your-secret-key-min-32-chars-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# OAuth2 Discord
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_REDIRECT_URI=http://localhost:3001/auth/discord/callback

# URLs
BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# CORS (TASK A-003): explicit browser origin allowlist, comma-separated.
# Production is same-origin behind nginx (/api/ -> backend) and may leave
# this empty. Cross-origin development needs the web origin listed here.
CORS_ORIGINS=http://localhost:3000

# Cookies (TASK A-002/A-003): lax (same-origin prod) | strict | none
# (cross-origin dev; forces Secure, which works on localhost).
COOKIE_SAMESITE=lax

# DRM v2 server signing key (Ed25519 PKCS8 DER, base64).
# Generate with: pnpm --filter @mta-market/server drm:keygen
DRM_SERVER_PRIVATE_KEY=

# Rate limits (requests per window; see src/lib/rateLimit.ts)
AUTH_RATE_LIMIT_MAX=5
STANDARD_RATE_LIMIT_MAX=60
STRICT_RATE_LIMIT_MAX=10

# S3 / Cloudflare R2 (optional)
S3_ENABLED=false
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# YooKassa (optional)
YOOKASSA_ENABLED=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_NOTIFICATION_PASSWORD=

# Email (optional)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@mtamarket.com
